## Test that llvm-readobj/llvm-readelf shows proper relocation type
## names and values for the alpha target.

# RUN: yaml2obj %s -o %t-alpha.o
# RUN: llvm-readobj -r --expand-relocs %t-alpha.o | FileCheck %s

# CHECK: Type: R_ALPHA_NONE (0)
# CHECK: Type: R_ALPHA_REFLONG (1)
# CHECK: Type: R_ALPHA_REFQUAD (2)
# CHECK: Type: R_ALPHA_GPREL32 (3)
# CHECK: Type: R_ALPHA_LITERAL (4)
# CHECK: Type: R_ALPHA_LITUSE (5)
# CHECK: Type: R_ALPHA_GPDISP (6)
# CHECK: Type: R_ALPHA_BRADDR (7)
# CHECK: Type: R_ALPHA_HINT (8)
# CHECK: Type: R_ALPHA_SREL16 (9)
# CHECK: Type: R_ALPHA_SREL32 (10)
# CHECK: Type: R_ALPHA_SREL64 (11)
# CHECK: Type: R_ALPHA_GPRELHIGH (17)
# CHECK: Type: R_ALPHA_GPRELLOW (18)
# CHECK: Type: R_ALPHA_GPREL16 (19)
# CHECK: Type: R_ALPHA_COPY (24)
# CHECK: Type: R_ALPHA_GLOB_DAT (25)
# CHECK: Type: R_ALPHA_JMP_SLOT (26)
# CHECK: Type: R_ALPHA_RELATIVE (27)
# CHECK: Type: R_ALPHA_BRSGP (28)
# CHECK: Type: R_ALPHA_TLSGD (29)
# CHECK: Type: R_ALPHA_TLSLDM (30)
# CHECK: Type: R_ALPHA_DTPMOD64 (31)
# CHECK: Type: R_ALPHA_GOTDTPREL (32)
# CHECK: Type: R_ALPHA_DTPREL64 (33)
# CHECK: Type: R_ALPHA_DTPRELHI (34)
# CHECK: Type: R_ALPHA_DTPRELLO (35)
# CHECK: Type: R_ALPHA_DTPREL16 (36)
# CHECK: Type: R_ALPHA_GOTTPREL (37)
# CHECK: Type: R_ALPHA_TPREL64 (38)
# CHECK: Type: R_ALPHA_TPRELHI (39)
# CHECK: Type: R_ALPHA_TPRELLO (40)
# CHECK: Type: R_ALPHA_TPREL16 (41)

--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_ALPHA
Sections:
  - Name: .rela.text
    Type: SHT_RELA
    Relocations:
      - Type: R_ALPHA_NONE
      - Type: R_ALPHA_REFLONG
      - Type: R_ALPHA_REFQUAD
      - Type: R_ALPHA_GPREL32
      - Type: R_ALPHA_LITERAL
      - Type: R_ALPHA_LITUSE
      - Type: R_ALPHA_GPDISP
      - Type: R_ALPHA_BRADDR
      - Type: R_ALPHA_HINT
      - Type: R_ALPHA_SREL16
      - Type: R_ALPHA_SREL32
      - Type: R_ALPHA_SREL64
      - Type: R_ALPHA_GPRELHIGH
      - Type: R_ALPHA_GPRELLOW
      - Type: R_ALPHA_GPREL16
      - Type: R_ALPHA_COPY
      - Type: R_ALPHA_GLOB_DAT
      - Type: R_ALPHA_JMP_SLOT
      - Type: R_ALPHA_RELATIVE
      - Type: R_ALPHA_BRSGP
      - Type: R_ALPHA_TLSGD
      - Type: R_ALPHA_TLSLDM
      - Type: R_ALPHA_DTPMOD64
      - Type: R_ALPHA_GOTDTPREL
      - Type: R_ALPHA_DTPREL64
      - Type: R_ALPHA_DTPRELHI
      - Type: R_ALPHA_DTPRELLO
      - Type: R_ALPHA_DTPREL16
      - Type: R_ALPHA_GOTTPREL
      - Type: R_ALPHA_TPREL64
      - Type: R_ALPHA_TPRELHI
      - Type: R_ALPHA_TPRELLO
      - Type: R_ALPHA_TPREL16
