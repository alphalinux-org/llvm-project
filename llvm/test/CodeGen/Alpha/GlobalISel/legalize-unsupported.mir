# RUN: llc -mtriple=alpha-unknown-linux-gnu -run-pass=legalizer %s -o - \
# RUN:   | FileCheck %s
# RUN: not llc -mtriple=alpha-unknown-linux-gnu -run-pass=legalizer \
# RUN:   -global-isel-abort=1 %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=ABORT
# RUN: llc -mtriple=alpha-unknown-linux-gnu -mattr=+no-fp-regs \
# RUN:   -run-pass=legalizer %s -o - | FileCheck %s --check-prefix=NOFP

# The rules that are deliberately `.unsupported()`: the division family, whose
# lowering the SelectionDAG path builds as a library call with a non-standard
# convention.  A rule that quietly lowered one of these instead would produce
# code that looks legal and calls the wrong thing.
#
# Without -global-isel-abort=1 the function is marked failedISel and handed
# whole to the SelectionDAG path, which is the arrangement being tested; the
# second run line pins the diagnostic the aborting form prints.

# ABORT: LLVM ERROR: unable to legalize instruction: {{.*}}G_SDIV

---
name:            sdiv
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: sdiv
    ; CHECK: failedISel: true
    ; CHECK: G_SDIV
    %0:_(s64) = COPY $r16
    %1:_(s64) = COPY $r17
    %2:_(s64) = G_SDIV %0, %1
    $r0 = COPY %2(s64)
    RET implicit $r0
...
---
name:            urem
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: urem
    ; CHECK: failedISel: true
    ; CHECK: G_UREM
    %0:_(s64) = COPY $r16
    %1:_(s64) = COPY $r17
    %2:_(s64) = G_UREM %0, %1
    $r0 = COPY %2(s64)
    RET implicit $r0
...

---
# Every floating rule is unsupported under -mno-fp-regs, which has no register
# for the result to live in.  The SelectionDAG path lowers such a function to
# the soft-float libcalls; this one has no lowering of its own, so it says so
# and the function goes there whole.  Without the feature the same rule is
# legal, which is what the first RUN line checks here.
name:            fadd
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $f16, $f17
    ; CHECK-LABEL: name: fadd
    ; CHECK-NOT: failedISel: true
    ; NOFP-LABEL: name: fadd
    ; NOFP: failedISel: true
    ; NOFP: G_FADD
    %0:_(s64) = COPY $f16
    %1:_(s64) = COPY $f17
    %2:_(s64) = G_FADD %0, %1
    $f0 = COPY %2(s64)
    RET implicit $f0
...

