# RUN: llc -mtriple=alpha-unknown-linux-gnu -run-pass=regbankselect %s -o - \
# RUN:   | FileCheck %s

# G_SELECT is the one instruction whose bank is not decided by its opcode: its
# condition is always an integer and the two values it chooses between follow
# whatever they are, so the mapping is read from both ends -- the definitions
# of the values and the use of the result -- the way a phi's is.  Reading only
# one end sends a choice between two floating values through a general
# register pair and back, which is a stack round trip rather than an fcmovne.

---
# Decided by the definitions: the values arrive in floating registers.
name:            from_defs
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $f17, $f18
    ; CHECK-LABEL: name: from_defs
    ; CHECK:      %[[C:[0-9]+]]:gpr(s1) = G_TRUNC
    ; CHECK-NEXT: %[[A:[0-9]+]]:fpr(s64) = COPY $f17
    ; CHECK-NEXT: %[[B:[0-9]+]]:fpr(s64) = COPY $f18
    ; CHECK-NEXT: %{{[0-9]+}}:fpr(s64) = G_SELECT %[[C]](s1), %[[A]], %[[B]]
    %0:_(s64) = COPY $r16
    %1:_(s1) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $f17
    %3:_(s64) = COPY $f18
    %4:_(s64) = G_SELECT %1(s1), %2, %3
    $f0 = COPY %4(s64)
    RET implicit $f0
...
---
# Decided by the use: the values come out of loads, which say nothing about
# the bank, and only the floating return register does.  The two cross-bank
# copies the mapping asks for are what the selector turns into the moves.
name:            from_use
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: from_use
    ; CHECK:      %{{[0-9]+}}:gpr(s64) = G_LOAD
    ; CHECK:      %{{[0-9]+}}:gpr(s64) = G_LOAD
    ; CHECK:      %{{[0-9]+}}:fpr(s64) = G_SELECT
    %0:_(s64) = COPY $r16
    %1:_(s1) = G_TRUNC %0(s64)
    %2:_(p0) = COPY $r17
    %3:_(s64) = G_LOAD %2(p0) :: (load (s64))
    %4:_(p0) = COPY $r18
    %5:_(s64) = G_LOAD %4(p0) :: (load (s64))
    %6:_(s64) = G_SELECT %1(s1), %3, %5
    $f0 = COPY %6(s64)
    RET implicit $f0
...
---
# Neither end is floating: an integer select stays in the general bank.
name:            integer
legalized:       true
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: integer
    ; CHECK: %{{[0-9]+}}:gpr(s64) = G_SELECT
    %0:_(s64) = COPY $r16
    %1:_(s1) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s64) = COPY $r18
    %4:_(s64) = G_SELECT %1(s1), %2, %3
    $r0 = COPY %4(s64)
    RET implicit $r0
...
