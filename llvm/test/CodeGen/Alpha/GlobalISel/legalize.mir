# RUN: llc -mtriple=alpha-unknown-linux-gnu -run-pass=legalizer %s -o - \
# RUN:   | FileCheck %s --check-prefixes=CHECK,BASE
# RUN: llc -mtriple=alpha-unknown-linux-gnu -mcpu=ev67 -run-pass=legalizer %s \
# RUN:   -o - | FileCheck %s --check-prefixes=CHECK,EV67

# The legalizer's rules as the subject rather than as a side effect of a whole
# compilation: an end-to-end test only shows that the output is *some* legal
# code, and a rule that widens what it should have left alone is invisible in
# it.

---
# A 32-bit select is legal as it stands: cmovne moves a whole register, so
# there is nothing to widen and the truncations feeding it stay put.
name:            select_s32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: select_s32
    ; CHECK: %[[C:[0-9]+]]:_(s1) = G_TRUNC
    ; CHECK: {{%[0-9]+}}:_(s32) = G_SELECT %[[C]](s1), %{{[0-9]+}}, %{{[0-9]+}}
    %0:_(s64) = COPY $r16
    %1:_(s1) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s32) = G_TRUNC %2(s64)
    %4:_(s64) = COPY $r18
    %5:_(s32) = G_TRUNC %4(s64)
    %6:_(s32) = G_SELECT %1(s1), %3, %5
    %7:_(s64) = G_ANYEXT %6(s32)
    $r0 = COPY %7(s64)
    RET implicit $r0
...
---
# A narrow add is widened to the register width, and the truncations that
# produced its operands disappear with it: nothing on Alpha adds eight bits.
name:            add_s8
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: add_s8
    ; CHECK:      %[[A:[0-9]+]]:_(s64) = COPY $r16
    ; CHECK-NEXT: %[[B:[0-9]+]]:_(s64) = COPY $r17
    ; CHECK-NEXT: %[[R:[0-9]+]]:_(s64) = G_ADD %[[A]], %[[B]]
    ; CHECK-NEXT: $r0 = COPY %[[R]](s64)
    %0:_(s64) = COPY $r16
    %1:_(s8) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s8) = G_TRUNC %2(s64)
    %4:_(s8) = G_ADD %1, %3
    %5:_(s64) = G_ANYEXT %4(s8)
    $r0 = COPY %5(s64)
    RET implicit $r0
...
---
# ctpop is an instruction on ev67 and the shift-and-multiply expansion
# everywhere else.  The expansion's tail is the multiply by 0x0101010101010101
# and the shift down by 56.
name:            ctpop
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: ctpop
    ; BASE:      %{{[0-9]+}}:_(s64) = G_CONSTANT i64 72340172838076673
    ; BASE:      %[[M:[0-9]+]]:_(s64) = G_MUL
    ; BASE-NEXT: %{{[0-9]+}}:_(s64) = G_LSHR %[[M]]
    ; EV67:      %{{[0-9]+}}:_(s64) = G_CTPOP
    %0:_(s64) = COPY $r16
    %1:_(s64) = G_CTPOP %0(s64)
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
# A narrow load defines a whole register: {s64, p0, s16} is legal, so nothing
# widens and no separate extension appears.  The s32 form is legal too, which
# is what keeps a float load in the floating-point bank instead of widening to
# s64 and reaching $f0 through the stack.
name:            load_s16
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: load_s16
    ; CHECK:      %[[P:[0-9]+]]:_(p0) = COPY $r16
    ; CHECK-NEXT: %[[V:[0-9]+]]:_(s64) = G_LOAD %[[P]](p0) :: (load (s16))
    ; CHECK-NEXT: $r0 = COPY %[[V]](s64)
    %0:_(p0) = COPY $r16
    %1:_(s64) = G_LOAD %0(p0) :: (load (s16))
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
name:            load_f32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: load_f32
    ; CHECK:      %[[P:[0-9]+]]:_(p0) = COPY $r16
    ; CHECK-NEXT: %[[V:[0-9]+]]:_(s32) = G_LOAD %[[P]](p0) :: (load (s32))
    %0:_(p0) = COPY $r16
    %1:_(s32) = G_LOAD %0(p0) :: (load (s32))
    %2:_(s64) = G_ANYEXT %1(s32)
    $r0 = COPY %2(s64)
    RET implicit $r0
...

---
# A non-power-of-two integer is widened to the next power of two before it is
# clamped to the register width, not after.  Clamping first would narrow this
# to a 64-bit part and a *one*-bit part, and the carry expansion would then
# build a G_ZEXT from s1 to s1 and assert "invalid narrowing extend" -- a crash
# no -global-isel-abort=0 can catch, because it happens inside the legalizer
# rather than at a decision to leave it.
name:            add_s65
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: add_s65
    ; CHECK: %{{[0-9]+}}:_(s64), %{{[0-9]+}}:_(s64) = G_UNMERGE_VALUES %{{[0-9]+}}(s128)
    %0:_(s64) = COPY $r16
    %1:_(s65) = G_ZEXT %0(s64)
    %2:_(s65) = G_CONSTANT i65 32
    %3:_(s65) = G_ADD %1, %2
    %4:_(s64) = G_TRUNC %3(s65)
    %5:_(s65) = G_SEXT %4(s64)
    %6:_(s1) = G_ICMP intpred(ne), %3(s65), %5
    %7:_(s64) = G_ZEXT %6(s1)
    $r0 = COPY %7(s64)
    RET implicit $r0
...

---
# A select of a type that is not a power of two but sits inside the range
# clampScalar was given.  clampScalar moves a type *outside* its range to the
# nearest end and leaves one inside it alone, so this passed through untouched
# and reached a selector with nothing to select; rounding up to the next power
# of two afterwards is what sends it to s64.
name:            select_s40
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: select_s40
    ; CHECK: {{%[0-9]+}}:_(s64) = G_SELECT
    ; CHECK-NOT: (s40) = G_SELECT
    %0:_(s64) = COPY $r16
    %1:_(s1) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s40) = G_TRUNC %2(s64)
    %4:_(s64) = COPY $r18
    %5:_(s40) = G_TRUNC %4(s64)
    %6:_(s40) = G_SELECT %1(s1), %3, %5
    %7:_(s64) = G_ANYEXT %6(s40)
    $r0 = COPY %7(s64)
    RET implicit $r0
...
---
# An extension to a destination narrower than a register.  Every entry in the
# rule once named an s64 destination and maxScalar is a ceiling only, so this
# matched nothing and was never widened up either -- `sext i8 to i32` feeding a
# 32-bit store is where it comes from.  It is legal as written: the selector
# switches on the source width, and sign-extending a byte across a whole
# register leaves the low 32 bits holding the s32 value.
#
# The s32 result has to be consumed *as* an s32, by the 32-bit store this
# comes from in practice.  Feeding it to a G_ANYEXT instead lets the artifact
# combiner fold the pair into a single s64 extension before the rule is ever
# consulted, and the test would pass without testing anything.
#
# The CHECK-NOT is load-bearing for the same reason.  A -run-pass=legalizer run
# that fails to legalize leaves the body exactly as written and marks the
# function failedISel, so checking only for the G_SEXT matched this test's own
# input and held with the rule reverted.  What is being asserted is that the
# extension survived legalization, not that it was written down.
name:            sext_s8_to_s32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: sext_s8_to_s32
    ; CHECK-NOT: failedISel: true
    ; CHECK: {{%[0-9]+}}:_(s32) = G_SEXT
    %0:_(s64) = COPY $r16
    %1:_(s8) = G_TRUNC %0(s64)
    %2:_(s32) = G_SEXT %1(s8)
    %3:_(p0) = COPY $r17
    G_STORE %2(s32), %3(p0) :: (store (s32))
    RET
...
