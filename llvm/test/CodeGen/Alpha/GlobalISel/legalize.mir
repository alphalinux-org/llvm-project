# RUN: llc -mtriple=alpha-unknown-linux-gnu -run-pass=legalizer %s -o - \
# RUN:   | FileCheck %s --check-prefixes=CHECK,BASE
# RUN: llc -mtriple=alpha-unknown-linux-gnu -mcpu=ev67 -run-pass=legalizer %s \
# RUN:   -o - | FileCheck %s --check-prefixes=CHECK,EV67

# The legalizer's rules as the subject rather than as a side effect of a whole
# compilation: an end-to-end test only shows that the output is *some* legal
# code, and a rule that widens what it should have left alone is invisible in
# it.

---
# A 32-bit select is legal in its value operands: cmovne moves a whole
# register, so there is nothing to widen and the s32 truncations feeding it
# stay put.  The condition is a different matter -- there is no s1 on this
# machine, so it is widened to a whole register, and the zero-extension of the
# truncate it came from is the `and %0, 1' below.  The selector folds that back
# into cmovlbs (see select.ll), so the mask costs nothing.
name:            select_s32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: select_s32
    ; CHECK: %[[C:[0-9]+]]:_(s64) = G_AND
    ; CHECK: {{%[0-9]+}}:_(s32) = G_SELECT %[[C]](s64), %{{[0-9]+}}, %{{[0-9]+}}
    %0:_(s64) = COPY $r16
    %1:_(s1) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s32) = G_TRUNC %2(s64)
    %4:_(s64) = COPY $r18
    %5:_(s32) = G_TRUNC %4(s64)
    %6:_(s32) = G_SELECT %1(s1), %3, %5
    %7:_(s64) = G_ANYEXT %6(s32)
    $r0 = COPY %7(s64)
    RET implicit $r0
...
---
# A misaligned access is legal, and stays exactly as it is: the rule names one
# byte as the alignment for every width, so `isCompatible` matches whatever
# alignment the access carries.  Alpha has no instruction that touches a datum
# straddling two quadwords, but that is the selector's business -- it expands
# this to the same ldq_u/extql/extqh sequence AlphaTargetLowering::LowerLOAD
# builds, and select-misaligned.mir is where that is checked.  What must not
# happen here is `lower()`, which would split it into byte accesses.
name:            load_misaligned
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: load_misaligned
    ; CHECK-NOT: G_PTR_ADD
    ; CHECK: {{%[0-9]+}}:_(s64) = G_LOAD %{{[0-9]+}}(p0) :: (load (s64), align 1)
    %0:_(p0) = COPY $r16
    %1:_(s64) = G_LOAD %0(p0) :: (load (s64), align 1)
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
# The store side of the same thing.  A misaligned store is a read-modify-write
# of both quadwords the field can fall in; splitting it here into two aligned
# halves would be correct and much worse, and into byte stores worse again.
name:            store_misaligned
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: store_misaligned
    ; CHECK-NOT: G_PTR_ADD
    ; CHECK: G_STORE %{{[0-9]+}}(s64), %{{[0-9]+}}(p0) :: (store (s64), align 1)
    %0:_(p0) = COPY $r16
    %1:_(s64) = COPY $r17
    G_STORE %1(s64), %0(p0) :: (store (s64), align 1)
    RET
...
---
# An extending load is legal for the three widths the loads cover, at any
# alignment, and stays as it is: the selector reads the field with the load and
# fills the register above it, and which of the two extensions costs an
# instruction depends on the load it chose -- see extload.mir.
#
# This rule exists rather than being left out.  An opcode with no rules at all
# has an empty rule set that verify() accepts vacuously, so the absence of a
# rule is not the absence of a claim; it is an unchecked one.
name:            zextload_s32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: zextload_s32
    ; CHECK: {{%[0-9]+}}:_(s64) = G_ZEXTLOAD %{{[0-9]+}}(p0) :: (load (s32))
    %0:_(p0) = COPY $r16
    %1:_(s64) = G_ZEXTLOAD %0(p0) :: (load (s32))
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
# A width that is not one of those three is what `lower()` is for, and it is
# the case lowerLoad can actually do: it splits the access into ones that are.
# The i40 at -O0 that produced the original G_ZEXTLOAD arrives exactly here.
name:            zextload_s40
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: zextload_s40
    ; CHECK-NOT: G_ZEXTLOAD %{{[0-9]+}}(p0) :: (load (s40)
    ; CHECK: G_ZEXTLOAD
    ; CHECK: G_PTR_ADD
    %0:_(p0) = COPY $r16
    %1:_(s64) = G_ZEXTLOAD %0(p0) :: (load (s40), align 1)
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
# A narrow add is widened to the register width, and the truncations that
# produced its operands disappear with it: nothing on Alpha adds eight bits.
name:            add_s8
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: add_s8
    ; CHECK:      %[[A:[0-9]+]]:_(s64) = COPY $r16
    ; CHECK-NEXT: %[[B:[0-9]+]]:_(s64) = COPY $r17
    ; CHECK-NEXT: %[[R:[0-9]+]]:_(s64) = G_ADD %[[A]], %[[B]]
    ; CHECK-NEXT: $r0 = COPY %[[R]](s64)
    %0:_(s64) = COPY $r16
    %1:_(s8) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s8) = G_TRUNC %2(s64)
    %4:_(s8) = G_ADD %1, %3
    %5:_(s64) = G_ANYEXT %4(s8)
    $r0 = COPY %5(s64)
    RET implicit $r0
...
---
# ctpop is an instruction on ev67 and the shift-and-multiply expansion
# everywhere else.  The expansion's tail is the multiply by 0x0101010101010101
# and the shift down by 56.
name:            ctpop
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: ctpop
    ; BASE:      %{{[0-9]+}}:_(s64) = G_CONSTANT i64 72340172838076673
    ; BASE:      %[[M:[0-9]+]]:_(s64) = G_MUL
    ; BASE-NEXT: %{{[0-9]+}}:_(s64) = G_LSHR %[[M]]
    ; EV67:      %{{[0-9]+}}:_(s64) = G_CTPOP
    %0:_(s64) = COPY $r16
    %1:_(s64) = G_CTPOP %0(s64)
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
# A narrow load defines a whole register: {s64, p0, s16} is legal, so nothing
# widens and no separate extension appears.  The s32 form is legal too, which
# is what keeps a float load in the floating-point bank instead of widening to
# s64 and reaching $f0 through the stack.
name:            load_s16
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: load_s16
    ; CHECK:      %[[P:[0-9]+]]:_(p0) = COPY $r16
    ; CHECK-NEXT: %[[V:[0-9]+]]:_(s64) = G_LOAD %[[P]](p0) :: (load (s16))
    ; CHECK-NEXT: $r0 = COPY %[[V]](s64)
    %0:_(p0) = COPY $r16
    %1:_(s64) = G_LOAD %0(p0) :: (load (s16))
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
name:            load_f32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: load_f32
    ; CHECK:      %[[P:[0-9]+]]:_(p0) = COPY $r16
    ; CHECK-NEXT: %[[V:[0-9]+]]:_(s32) = G_LOAD %[[P]](p0) :: (load (s32))
    %0:_(p0) = COPY $r16
    %1:_(s32) = G_LOAD %0(p0) :: (load (s32))
    %2:_(s64) = G_ANYEXT %1(s32)
    $r0 = COPY %2(s64)
    RET implicit $r0
...

---
# A non-power-of-two integer is widened to the next power of two before it is
# clamped to the register width, not after.  Clamping first would narrow this
# to a 64-bit part and a *one*-bit part, and the carry expansion would then
# build a G_ZEXT from s1 to s1 and assert "invalid narrowing extend" -- a crash
# no -global-isel-abort=0 can catch, because it happens inside the legalizer
# rather than at a decision to leave it.
name:            add_s65
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: add_s65
    ; CHECK: %{{[0-9]+}}:_(s64), %{{[0-9]+}}:_(s64) = G_UNMERGE_VALUES %{{[0-9]+}}(s128)
    %0:_(s64) = COPY $r16
    %1:_(s65) = G_ZEXT %0(s64)
    %2:_(s65) = G_CONSTANT i65 32
    %3:_(s65) = G_ADD %1, %2
    %4:_(s64) = G_TRUNC %3(s65)
    %5:_(s65) = G_SEXT %4(s64)
    %6:_(s1) = G_ICMP intpred(ne), %3(s65), %5
    %7:_(s64) = G_ZEXT %6(s1)
    $r0 = COPY %7(s64)
    RET implicit $r0
...
---
# An extension to a destination narrower than a register.  maxScalar is a
# ceiling only, so with s64 destinations alone this would match nothing and
# would not be widened up either -- `sext i8 to i32` feeding a 32-bit store is
# where it comes from.  It is legal as written: the selector switches on the
# source width, and sign-extending a byte across a whole register leaves the
# low 32 bits holding the s32 value.
#
# The s32 result has to be consumed *as* an s32, by the 32-bit store this
# comes from in practice.  Feeding it to a G_ANYEXT instead lets the artifact
# combiner fold the pair into a single s64 extension before the rule is ever
# consulted, and the test would pass without testing anything.
#
# The CHECK-NOT is load-bearing for the same reason.  A -run-pass=legalizer run
# that fails to legalize leaves the body exactly as written and marks the
# function failedISel, so checking only for the G_SEXT would match this test's
# own input and hold without the rule.  What is being asserted is that the
# extension survived legalization, not that it was written down.
name:            sext_s8_to_s32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17
    ; CHECK-LABEL: name: sext_s8_to_s32
    ; CHECK-NOT: failedISel: true
    ; CHECK: {{%[0-9]+}}:_(s32) = G_SEXT
    %0:_(s64) = COPY $r16
    %1:_(s8) = G_TRUNC %0(s64)
    %2:_(s32) = G_SEXT %1(s8)
    %3:_(p0) = COPY $r17
    G_STORE %2(s32), %3(p0) :: (store (s32))
    RET
...

---
# A select of a type that is not a power of two but sits inside the range
# clampScalar was given.  clampScalar moves a type *outside* its range to the
# nearest end and leaves one inside it alone, so without a rounding step this
# would pass through untouched and reach a selector with nothing to select;
# rounding up to the next power of two afterwards is what sends it to s64.
name:            select_s40
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: select_s40
    ; CHECK: {{%[0-9]+}}:_(s64) = G_SELECT
    ; CHECK-NOT: (s40) = G_SELECT
    %0:_(s64) = COPY $r16
    %1:_(s1) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s40) = G_TRUNC %2(s64)
    %4:_(s64) = COPY $r18
    %5:_(s40) = G_TRUNC %4(s64)
    %6:_(s40) = G_SELECT %1(s1), %3, %5
    %7:_(s64) = G_ANYEXT %6(s40)
    $r0 = COPY %7(s64)
    RET implicit $r0
...

---
# A condition wider than a boolean.  It arrives this way when whatever produced
# it was itself widened, and there is nothing to be done about that here:
# LegalizerHelper::narrowScalarSelect refuses every operand but the
# destination, so a rule that clamped the condition back to s1 would report
# legal and fail one step later.  The quadword form is legal instead, and it
# needs nothing new in the selector: cmovne's own pattern is written on an i64
# condition, so the imported patterns match it.
name:            select_cond_s64
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: select_cond_s64
    ; CHECK-NOT: failedISel: true
    ; CHECK: {{%[0-9]+}}:_(s64) = G_SELECT {{%[0-9]+}}(s64)
    %0:_(s64) = COPY $r16
    %1:_(s64) = COPY $r17
    %2:_(s64) = COPY $r18
    %3:_(s64) = G_SELECT %0(s64), %1, %2
    $r0 = COPY %3(s64)
    RET implicit $r0
...
---
# A condition that is neither a boolean nor a quadword is widened to one.  The
# extension is a zero extension and not an any extension: the target's boolean
# contents are ZeroOrOne, so the bits above the low one are known to be zero
# rather than merely ignored.
name:            select_cond_s32
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16, $r17, $r18
    ; CHECK-LABEL: name: select_cond_s32
    ; CHECK-NOT: failedISel: true
    ; CHECK: {{%[0-9]+}}:_(s64) = G_SELECT {{%[0-9]+}}(s64)
    %0:_(s64) = COPY $r16
    %1:_(s32) = G_TRUNC %0(s64)
    %2:_(s64) = COPY $r17
    %3:_(s64) = COPY $r18
    %4:_(s64) = G_SELECT %1(s32), %2, %3
    $r0 = COPY %4(s64)
    RET implicit $r0
...

---
# An extension whose source is not a power of two.  This is what a load of an
# odd size lowers to, and it is the end of the road for the helper: widenScalar
# has no case for an extension at all and lowerEXT handles only vectors, so if
# the rule does not call this legal the function falls back.
name:            sext_s24
legalized:       false
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r16
    ; CHECK-LABEL: name: sext_s24
    ; CHECK-NOT: failedISel: true
    ; CHECK: {{%[0-9]+}}:_(s64) = G_SEXT {{%[0-9]+}}(s24)
    %0:_(s64) = COPY $r16
    %1:_(s24) = G_TRUNC %0(s64)
    %2:_(s64) = G_SEXT %1(s24)
    $r0 = COPY %2(s64)
    RET implicit $r0
...
