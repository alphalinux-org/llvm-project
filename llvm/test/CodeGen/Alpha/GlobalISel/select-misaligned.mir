# RUN: llc -mtriple=alpha-unknown-linux-gnu -run-pass=instruction-select \
# RUN:   -global-isel-abort=1 -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=alpha-unknown-linux-gnu -mattr=+safe-partial \
# RUN:   -run-pass=instruction-select -global-isel-abort=1 \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=SAFE

# An under-aligned access must not reach a selected ldq or stq.  Alpha does not
# fault on one: it ignores the low address bits and touches the wrong bytes, so
# a wrong answer is the failure mode, not a signal.
#
# The legalizer declares these legal -- deliberately, because saying otherwise
# handed the whole function to the SelectionDAG path, and a load from a packed
# struct member was enough to do it -- so the selector is the only thing
# standing between an align-1 quadword access and an ldq.  This asks the
# question of the selection pass alone, where nothing else can answer it: an
# end-to-end run would produce plausible output either way, since the
# SelectionDAG path builds the same sequence.
#
# -global-isel-abort=1 is part of the question.  Without it a refusal here is
# recorded as failedISel and the function falls back, which is exactly the
# state this expansion exists to end.

---
name:            load_underaligned
alignment:       1
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
liveins:
  - { reg: '$r16' }
body:             |
  bb.1:
    liveins: $r16

    ; Both extracts take the original address, which is what says where in the
    ; quadword pair the field begins; only the second ldq_u takes the address
    ; of the field's last byte, which is in the second quadword exactly when
    ; the field straddles the boundary.
    ; CHECK-LABEL: name: load_underaligned
    ; CHECK-NOT: failedISel: true
    ; CHECK: %[[LO:[0-9]+]]:gprc = LDQ_U %[[P:[0-9]+]]
    ; CHECK: %[[HIP:[0-9]+]]:gprc = LDA 7, %[[P]]
    ; CHECK: %[[HI:[0-9]+]]:gprc = LDQ_U %[[HIP]]
    ; CHECK: %[[EL:[0-9]+]]:gprc = EXTQL %[[LO]], %[[P]]
    ; CHECK: %[[EH:[0-9]+]]:gprc = EXTQH %[[HI]], %[[P]]
    ; CHECK: BIS %[[EL]], %[[EH]]
    ; CHECK-NOT: LDQ %
    %0:gpr(p0) = COPY $r16
    %1:gpr(s64) = G_LOAD %0(p0) :: (load (s64), align 1)
    $r0 = COPY %1(s64)
    RET implicit $r0
...
---
name:            store_underaligned
alignment:       1
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
liveins:
  - { reg: '$r16' }
  - { reg: '$r17' }
body:             |
  bb.1:
    liveins: $r16, $r17

    ; The store is one pseudo, expanded later: it needs four scratch registers,
    ; and it has to stay indivisible until it is expanded, because two such
    ; stores can fall in one quadword and interleaving one's reads with the
    ; other's write-backs loses the field written first.  With -msafe-partial
    ; it is the lock-based form, which finds its own scratch registers inside
    ; its inserter.
    ; CHECK-LABEL: name: store_underaligned
    ; CHECK-NOT: failedISel: true
    ; CHECK: dead early-clobber %{{[0-9]+}}:gprc, dead early-clobber %{{[0-9]+}}:gprc, dead early-clobber %{{[0-9]+}}:gprc, dead early-clobber %{{[0-9]+}}:gprc = RMW_USTORE %{{[0-9]+}}, %{{[0-9]+}}, 8 :: (store (s64), align 1)
    ; CHECK-NOT: STQ %
    ; SAFE-LABEL: name: store_underaligned
    ; SAFE: SAFE_USTORE %{{[0-9]+}}, %{{[0-9]+}}, 8 :: (store (s64), align 1)
    %0:gpr(p0) = COPY $r16
    %1:gpr(s64) = COPY $r17
    G_STORE %1(s64), %0(p0) :: (store (s64), align 1)
    RET
...
---
name:            load_aligned
alignment:       1
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
liveins:
  - { reg: '$r16' }
body:             |
  bb.1:
    liveins: $r16

    ; The accept side, and the one that says the expansion above is reached by
    ; the alignment and not by the opcode: a naturally aligned load of the same
    ; width is a plain ldq.
    ; CHECK-LABEL: name: load_aligned
    ; CHECK-NOT: failedISel: true
    ; CHECK: LDQ
    ; CHECK-NOT: LDQ_U
    %0:gpr(p0) = COPY $r16
    %1:gpr(s64) = G_LOAD %0(p0) :: (load (s64))
    $r0 = COPY %1(s64)
    RET implicit $r0
...
