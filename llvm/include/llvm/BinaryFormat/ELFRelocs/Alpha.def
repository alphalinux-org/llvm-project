#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// Relocation numbers from the Alpha ELF ABI (binutils include/elf/alpha.h).
// Numbers 12-16 and 20-23 are deprecated ECOFF relocs and are intentionally
// unused.
ELF_RELOC(R_ALPHA_NONE,        0)
ELF_RELOC(R_ALPHA_REFLONG,     1)
ELF_RELOC(R_ALPHA_REFQUAD,     2)
ELF_RELOC(R_ALPHA_GPREL32,     3)
ELF_RELOC(R_ALPHA_LITERAL,     4)
ELF_RELOC(R_ALPHA_LITUSE,      5)
ELF_RELOC(R_ALPHA_GPDISP,      6)
ELF_RELOC(R_ALPHA_BRADDR,      7)
ELF_RELOC(R_ALPHA_HINT,        8)
ELF_RELOC(R_ALPHA_SREL16,      9)
ELF_RELOC(R_ALPHA_SREL32,      10)
ELF_RELOC(R_ALPHA_SREL64,      11)
ELF_RELOC(R_ALPHA_GPRELHIGH,   17)
ELF_RELOC(R_ALPHA_GPRELLOW,    18)
ELF_RELOC(R_ALPHA_GPREL16,     19)
ELF_RELOC(R_ALPHA_COPY,        24)
ELF_RELOC(R_ALPHA_GLOB_DAT,    25)
ELF_RELOC(R_ALPHA_JMP_SLOT,    26)
ELF_RELOC(R_ALPHA_RELATIVE,    27)
ELF_RELOC(R_ALPHA_BRSGP,       28)
ELF_RELOC(R_ALPHA_TLSGD,       29)
ELF_RELOC(R_ALPHA_TLSLDM,      30)
ELF_RELOC(R_ALPHA_DTPMOD64,    31)
ELF_RELOC(R_ALPHA_GOTDTPREL,   32)
ELF_RELOC(R_ALPHA_DTPREL64,    33)
ELF_RELOC(R_ALPHA_DTPRELHI,    34)
ELF_RELOC(R_ALPHA_DTPRELLO,    35)
ELF_RELOC(R_ALPHA_DTPREL16,    36)
ELF_RELOC(R_ALPHA_GOTTPREL,    37)
ELF_RELOC(R_ALPHA_TPREL64,     38)
ELF_RELOC(R_ALPHA_TPRELHI,     39)
ELF_RELOC(R_ALPHA_TPRELLO,     40)
ELF_RELOC(R_ALPHA_TPREL16,     41)
ELF_RELOC(R_ALPHA_IRELATIVE,   42)
